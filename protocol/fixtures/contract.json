{
 "_doc": "Contract fixtures shared by the executable mock and the real service. kind selects the validator; valid=false cases must be refused with expect_code. {\"$repeat\": [text, n]} expands to text*n.",
 "cases": [
  {
   "name": "task minimal",
   "kind": "task_request",
   "valid": true,
   "body": {
    "workspace_id": "w1",
    "instruction": "explain calc.py",
    "idempotency_key": "k-1"
   }
  },
  {
   "name": "task read mode with version",
   "kind": "task_request",
   "valid": true,
   "body": {
    "protocol": "1.0",
    "workspace_id": "w1",
    "instruction": "x",
    "idempotency_key": "k-2",
    "mode": "read"
   }
  },
  {
   "name": "task newer minor version is accepted",
   "kind": "task_request",
   "valid": true,
   "body": {
    "protocol": "1.7",
    "workspace_id": "w1",
    "instruction": "x",
    "idempotency_key": "k-3"
   }
  },
  {
   "name": "task missing workspace",
   "kind": "task_request",
   "valid": false,
   "expect_code": "VALIDATION_FAILED",
   "expect_field": "workspace_id",
   "body": {
    "instruction": "x",
    "idempotency_key": "k"
   }
  },
  {
   "name": "task empty instruction",
   "kind": "task_request",
   "valid": false,
   "expect_code": "VALIDATION_FAILED",
   "expect_field": "instruction",
   "body": {
    "workspace_id": "w",
    "instruction": "",
    "idempotency_key": "k"
   }
  },
  {
   "name": "task instruction too long",
   "kind": "task_request",
   "valid": false,
   "expect_code": "VALIDATION_FAILED",
   "expect_field": "instruction",
   "body": {
    "workspace_id": "w",
    "instruction": {
     "$repeat": [
      "x",
      16385
     ]
    },
    "idempotency_key": "k"
   }
  },
  {
   "name": "task wrong type",
   "kind": "task_request",
   "valid": false,
   "expect_code": "VALIDATION_FAILED",
   "expect_field": "workspace_id",
   "body": {
    "workspace_id": 5,
    "instruction": "x",
    "idempotency_key": "k"
   }
  },
  {
   "name": "task boolean is not a string",
   "kind": "task_request",
   "valid": false,
   "expect_code": "VALIDATION_FAILED",
   "expect_field": "idempotency_key",
   "body": {
    "workspace_id": "w",
    "instruction": "x",
    "idempotency_key": true
   }
  },
  {
   "name": "task unknown field is refused",
   "kind": "task_request",
   "valid": false,
   "expect_code": "VALIDATION_FAILED",
   "expect_field": "mode_typo",
   "body": {
    "workspace_id": "w",
    "instruction": "x",
    "idempotency_key": "k",
    "mode_typo": "read"
   }
  },
  {
   "name": "task execute mode is not offered",
   "kind": "task_request",
   "valid": false,
   "expect_code": "UNSUPPORTED_MODE",
   "expect_field": "mode",
   "body": {
    "workspace_id": "w",
    "instruction": "x",
    "idempotency_key": "k",
    "mode": "execute"
   }
  },
  {
   "name": "task other major version fails closed",
   "kind": "task_request",
   "valid": false,
   "expect_code": "VERSION_MISMATCH",
   "body": {
    "protocol": "2.0",
    "workspace_id": "w",
    "instruction": "x",
    "idempotency_key": "k"
   }
  },
  {
   "name": "task malformed version",
   "kind": "task_request",
   "valid": false,
   "expect_code": "BAD_REQUEST",
   "body": {
    "protocol": "abc",
    "workspace_id": "w",
    "instruction": "x",
    "idempotency_key": "k"
   }
  },
  {
   "name": "task body is a list",
   "kind": "task_request",
   "valid": false,
   "expect_code": "BAD_REQUEST",
   "body": [
    "x"
   ]
  },
